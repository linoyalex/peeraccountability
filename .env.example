# Chalkline — copy to .env.local and fill in with this project's own Supabase project credentials.
# See SETUP.md Part 0 §3 for where each value comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional local-only authentication bypass for exercising multiple seeded accounts without
# consuming Supabase's built-in email quota. Comma-separated; ignored outside `next dev` and
# rejected unless the request uses a loopback hostname such as localhost.
DEV_TEST_USER_EMAILS=

# The app's own public origin, used to build the magic-link `emailRedirectTo`
# (app/login/page.tsx). Leave BLANK for local development: the code falls back to
# http://localhost:3000, which is what you want on a dev machine.
#
# It must be set in any deployed environment. Without it a deployment emails links
# pointing at localhost, which nobody but the developer can open.
#
# Whatever value goes here must ALSO be listed in Supabase -> Authentication ->
# URL Configuration -> Redirect URLs. Supabase silently ignores an emailRedirectTo
# it doesn't recognise and substitutes the project's Site URL instead, which looks
# exactly like the app requesting the wrong address.
NEXT_PUBLIC_SITE_URL=

# Not read by the app — convenience reference only, used when writing .mcp.json (SETUP.md Part 2).
SUPABASE_PROJECT_REF=
